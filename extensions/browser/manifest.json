{
  "manifest_version": 3,
  "name": "Wowie Focus Companion",
  "version": "0.1.0",
  "description": "Privacy-preserving active browser tab origin reporter for the Wowie Linux desktop AI companion.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wowie-companion@wowie.local",
      "strict_min_version": "109.0"
    }
  }
}
